# ThreadSanitizer suppressions for the scenario suite.
#
# Every entry here is a race that is known and understood. The nightly TSan
# run goes red on anything else, so a new race fails the run while these are
# worked off. When one is fixed, delete its lines here in the same change
# (and check the run still passes: a suppression that matches more than its
# own race hides others).
#
# Keep patterns narrow. TSan matches a race: pattern against both access
# stacks, the stacks that created the threads involved, and global variable
# names, so a function that starts a thread (OpenSequenceFile, MainLoop,
# StartChannelOutputThread) would hide every race on that thread. Suppress a
# global by its exact name (race:^Name$) and anything else with race_top:,
# which matches only the function making the racy access -- except where that
# access is a memcpy/memset: the top frame is then TSan's interceptor, so
# race_top: never matches, and race: on a function that starts no thread is
# used instead.

# ---- fppd: shared data written outside its owner (fix these first) --------

# m_seqData: blanking and the first-frame read run on the
# main, HTTP and playlist threads while the output thread and the UDP workers
# use the same buffer.
race:Sequence::BlankSequenceData
race:UncompressedFrameData::readFrame
# ...and UDP outputs send straight from it (zero copy): a worker still
# sending frame N to a slow destination reads the buffer while the output
# thread builds frame N+1 into it. Fix: double-buffer the frame, or wait for
# such stragglers before building the next one. Suppressed on the writer
# side so a reader-side pattern can't hide the PrepData race fixed in fpp
# b95acec2f.
race_top:PixelOverlayManager::doOverlays
race:OutputProcessors::ProcessData
# Test mode is one more such writer: its pattern is copied over the frame
# while a slow destination's worker still sends the last one
# (test_output_pacing.py). A memcpy, so race: on the function, which starts
# no thread.
race:TestPatternBase::OverlayTestData

# ---- fppd: flags and counters shared across threads (std::atomic) ----------

# The crash log ring accepts a torn line by design (log.cpp). Permanent.
race:^s_crashRing$

# ---- by design --------------------------------------------------------------

# Overlay model pixel data is shared memory that effects, the HTTP API and
# programs outside fppd write while the output thread copies it out, with no
# lock on purpose: the worst case is a pixel from the previous effect frame.
race:PixelOverlayModel::setPixelValue
race:PixelOverlayModel::doOverlay
race:PixelOverlayModel::fillData
race:PixelOverlayModel::setData
race:PixelOverlayModel::blitData
# ...including the dirty flag in that shared buffer's header.
race_top:PixelOverlayModel::overlayBufferIsDirty
race:PixelOverlayModel::flushOverlayBuffer
# Making these accesses atomic needs a plugin ABI change (PixelOverlayModel's
# layout); it is on the FPP 11 list.
# The fill, bulk draw and clear of that buffer (two API requests filling one
# model, or an effect's stop clearing it meanwhile), a submodel's draw into
# its parent, and the model's own dirty flag, which says the same as the
# header's.
race:PixelOverlayModel::fillOverlayBuffer
race:PixelOverlayModel::blitOverlayBuffer
race:PixelOverlayModel::clearOverlayBuffer
race:PixelOverlayModelSub::doOverlay
race_top:PixelOverlayModel::needRefresh

# ---- by design: lock order TSan can't see is safe ----------------------------

# Inserting a playlist holds the parent's m_playlistMutex while PlayImpl()
# takes the child's; later the child's SetIdle() calls the parent's Resume(),
# taking them the other way round. TSan pairs the locks by address over
# time, but this cannot deadlock: SwitchToInsertedPlaylist() starts a child
# it created a moment earlier and has not published yet (SetCurrentPlaylist()
# runs only after PlayImpl() returns), so no other thread can be holding the
# child's lock then. Other threads reach playlists only through the Player's
# current snapshot, m_parent chains or PL_CLEANUPS. Don't rework the insert
# path to silence this.
deadlock:Playlist::PlayImpl
deadlock:Playlist::Resume

# ---- signal handlers ------------------------------------------------------

# The crash handler logs and writes a report, which no handler can do with
# async-signal-safe calls only. It runs once, when fppd has already crashed,
# and that crash is what fails the scenario.
signal:handleCrash

# ---- fppd: shutdown only ---------------------------------------------------

# main() calls CloseOpenFiles() on the way out while overlay models still
# exist, so a framebuffer model's draw thread can still be using its device
# fd (seen through test_fbdev.py's fake device). Fix: tear the overlay
# models down before closing fds.
race:CloseOpenFiles

# ---- uninstrumented libraries ----------------------------------------------

# GStreamerOutput's callback guard is published to the streaming threads by
# g_signal_connect() and gst_bus_set_sync_handler(), whose locking happens
# inside GLib/GStreamer where TSan can't see it, so the first read in a pad
# or bus callback looks unordered.
race:GStreamerOutput::LockCallbackGuard
race:GStreamerOutput::BusCallbackScope::BusCallbackScope
# ...and the guard's copy the bus holds is freed through the same unseen
# locking, by the bus's destroy notify on whichever thread drops it.
race:GStreamerOutput::ReleaseBusCallbackGuard
# GLib's own threads hand blocks to each other through GLib's locks; TSan
# sees only libc allocating on one and freeing on the other.
race:libc.so.6
# GraphicsMagick decodes and scales images on OpenMP worker threads, joined
# through libgomp's barriers, which TSan can't see. Not called_from_lib:
# that also hides its mutex calls, and fppd's own unlock of one at startup
# then reads as unbalanced.
race:libGraphicsMagick-Q16.so.3
# OpenSSL 3.5 (SHA1() for the WLED API's WebSocket handshake): two first
# handshakes at once fill libcrypto's algorithm cache, one under its rwlock,
# the other reading without it through lookups whose atomics, in an
# uninstrumented libcrypto, TSan can't see. The block is libcrypto's own
# (CRYPTO_malloc), not fppd's (test_wled_api.py's stalled client).
race:libcrypto.so.3
called_from_lib:liborc-0.4.so

# trantor: TcpServer::stop's promise/future (synchronised in libstdc++,
# which TSan can't see), its teardown, and the eventfd wakeup.
race:trantor::TcpServer::stop
race:trantor::TcpServer::~TcpServer
# The same promise, once libfpp has a std::promise<void> of its own (mqtt.cpp,
# since fpp 11a37e5ed): libtrantor's set_value() then binds to libfpp's
# instrumented copy of the shared state's setter, so TSan sees each IO loop
# write the promise that TcpServer::stop() reuses on its stack for the next,
# but not the future.get() wait between them. The frame below the setter is a
# lambda in stop() that libtrantor doesn't export, so the line above can't
# match it. Only a promise's own set path runs _M_do_set.
race:std::__future_base::_State_baseV2::_M_do_set
race:trantor::EventLoop::wakeup
race:trantor::EventLoop::queueInLoop
# fppd's shutdown barrier (QuiesceHttpServer, since fpp 547a957ac) queues a
# task on each IO loop: the task's closure and the barrier it shares are
# built on the main thread before queueInLoop() and read on the IO thread,
# handed over through the same MpscQueue. The function starts no thread.
race:QuiesceHttpServer
# A WebSocket frame sent from outside its connection's IO loop -- the status
# push (StatusWebSocket.cpp) sends from drogon's main-loop timer -- is built
# on that thread and handed to the IO loop in a queued functor, through
# trantor's lock-free MpscQueue, whose atomics are in libtrantor where TSan
# can't see them. The IO thread's write() of the frame and its free of the
# functor then look unordered against the thread that built them (seen in
# test_status_websocket.py). Only the string-taking send hands a buffer over.
race:drogon::WebSocketConnectionImpl::sendWsData
race:trantor::TcpConnectionImpl::send(std::__cxx11::basic_string
# drogon tearing down its router at shutdown while IO threads dispatch: the
# router's map of controllers is freed on drogon's main-loop thread while an
# IO thread still drops its reference to a handler, through shared_ptr
# atomics in libdrogon that TSan doesn't see ordered with the free. Only the
# map's destructor: the bare type name also matched doControllerHandler(),
# whose parameters name it, which hid every race with an API handler on the
# stack.
race:drogon::HttpControllersRouter::HttpControllerRouterItem*::~_Hashtable
race:std::__detail::_NFA
# libstdc++ fills ctype<char>::narrow()'s cache lazily, from whichever
# thread asks first (GCC PR 77704): two threads compiling a regex at once,
# as drogon's router and controller detection do, write the same bytes.
race:std::ctype<char>::narrow
# GStreamer/GLib hand objects between their own threads. called_from_lib
# drops only interceptor calls made inside the library, so FPP's callbacks
# on GStreamer threads are still checked. Each name must match exactly one
# loaded library, or TSan exits at startup.
called_from_lib:libglib-2.0.so
called_from_lib:libgstreamer-1.0.so
called_from_lib:libgstbase-1.0.so
called_from_lib:libgstapp-1.0.so
called_from_lib:libgstcoreelements.so
called_from_lib:libgobject-2.0.so
called_from_lib:libgstaudio-1.0.so
called_from_lib:libgstaudioconvert.so
called_from_lib:libpipewire-0.3.so
# pipewiresink. GLib's g_rec_mutex_unlock() tail-calls pthread_mutex_unlock(),
# so an unlock of a GRecMutex that GLib locked (unseen, above) is attributed
# to this plugin, and reads as an unlock of an unlocked mutex: seen from
# PipeWireOutputStream::WaitDrained()'s flush.
called_from_lib:libgstpipewire.so
called_from_lib:libgstplayback.so
called_from_lib:libgstvolume.so
# The video paths (test_video.py): demux, decode, the test source, and RTP
# over UDP.
called_from_lib:libgstvideo-1.0.so
called_from_lib:libgstvideotestsrc.so
called_from_lib:libgstmatroska.so
called_from_lib:libgstvorbis.so
called_from_lib:libvorbis.so.0
called_from_lib:libgstudp.so
called_from_lib:libgstvpx.so
# ...and libvpx under vpxdec: the VP8 decoder's frame and row buffers are
# allocated on the streaming thread as the first frame is decoded, inside the
# chain call that holds the sink pad's stream lock, and freed by vpxdec's
# stop() on FPP's teardown thread (VideoInputManager::StopSource()) after the
# pad's deactivation has taken that same lock -- a GRecMutex locked inside
# GLib. Seen when fppd stops while a file input is still prerolling
# (test_video.py's video file input source).
called_from_lib:libvpx.so.9
called_from_lib:libgio-2.0.so
# Opus RTP's encoder (test_aes67_config.py): the same g_rec_mutex_unlock()
# tail call as pipewiresink above, attributed to this plugin when an Opus
# send pipeline is built and torn down.
called_from_lib:libgstopus.so
# rtspsrc's RTP session manager and souphttpsrc (test_rtsp_inputs.py, the
# YouTube source in test_video_input_sources.py): the same GLib-lock hand-offs
# and g_rec_mutex_unlock() tail call as the plugins above.
called_from_lib:libgstrtpmanager.so
# interaudiosink/interaudiosrc (the RTSP audio bridge, test_rtsp_outputs.py):
# their shared channels are a list under a GMutex inside libgstinter, unseen;
# a bridge torn down on the GStreamer reaper thread frees a channel's name
# that the other end compared under that mutex.
called_from_lib:libgstinter.so
called_from_lib:libgstsoup.so
called_from_lib:libsoup-3.0.so.0
# VideoInputManager's RTSP stream filter (RtspStreamFilter) is allocated when
# the pipeline is built, read by rtspsrc's select-stream and no-more-pads
# handlers on its own threads, read again by the run thread after rtspsrc
# posts an error, and freed with the element after the teardown thread has
# set the pipeline to NULL, which joins rtspsrc's threads. Every hand-off is
# a GObject signal connection, a bus message or a GstTask join, all inside
# GLib/GStreamer where TSan can't see them. Only these handlers touch it,
# including pad-added (RtspLinkPadToBranch), connected when the camera's
# audio is used (test_video.py's reload-warning scenario).
race:RtspSelectStream
race:RtspNoMorePads
race:RtspFailedForNoVideo
race:RtspLinkPadToBranch
# A pad probe's state is published to the streaming thread by
# gst_pad_add_probe() and freed by the probe's destroy notify once the pad
# can no longer call it; both under the pad's lock, unseen. The crop region
# (VideoOutputManager's CropCapsProbe) is read only at the top of
# ApplyCropForFrameSize(); a destroy notify always runs from g_hook_free().
race_top:ApplyCropForFrameSize
race:g_hook_free
called_from_lib:libgstdebugutilsbad.so
called_from_lib:libjpeg.so.62
# kmssink (the HDMI groups), rtspsrc (cameras) and the RTSP server (playback
# slots served over RTSP): GRecMutex unlocks attributed to the plugin, as with
# pipewiresink above, and blocks handed between their own threads and the
# FPP thread tearing them down, under GLib locks TSan can't see.
called_from_lib:libgstkms.so
called_from_lib:libgstrtsp.so
called_from_lib:libgstrtspserver-1.0.so
# ...and the RTSP connection library under both. A viewer's watch (a GSource)
# is read-dispatched on the server's client thread and finalized on whichever
# thread drops its last reference: fppd's main thread when
# RTSPOutputManager::StopServer() closes the viewers on a reload or disable
# (test_rtsp_outputs.py's viewers-disconnected scenario). The dispatch holds
# a reference until it returns; that refcount and the context lock are
# GLib's, unseen.
called_from_lib:libgstrtsp-1.0.so.0
# alsasink on the ALSA media backend (test_audio_backends.py): the PCM that
# libasound allocates when alsasink opens it on one streaming thread is
# locked by snd_pcm_delay() on the ring buffer's thread, started after the
# open under GLib's locks, unseen.
called_from_lib:libasound.so.2
# A dmabuf's fd (fakehwdec.c's device-memory frames, test_video_consumers.py)
# is mapped by the decoder's thread as it fills the frame and closed by the
# dmabuf allocator on whichever thread drops the frame's last reference; the
# frame is handed downstream under GStreamer's locks, unseen.
called_from_lib:libgstallocators-1.0.so.0
# MP3 parse and decode: mpegaudioparse's and mpg123dec's state is used on the
# streaming thread and freed by the pipeline teardown (FPP-GstReaper), ordered
# by GStreamer's stream lock.
called_from_lib:libgstaudioparsers.so
called_from_lib:libgstmpg123.so
called_from_lib:libmpg123.so.0
# qtdemux (MP4/M4A, test_playlist_media.py's fragmented MP4): the same
# g_rec_mutex_unlock() tail call as pipewiresink above, and its sample tables,
# grown on the streaming thread, freed by the pipeline teardown
# (FPP-GstReaper) under GStreamer's stream lock.
called_from_lib:libgstisomp4.so
# The overlay member's appsink callback reads the state pointer it was given
# through gst_app_sink_set_callbacks(), whose lock is inside libgstapp and so
# ignored above: TSan loses that hand-off and reports the read against the
# allocation. The state itself is read under its own (visible) mutex.
race:VideoOutputManager::OnOverlaySample
# PipeWire loads and unloads its modules as it goes, and TSan aborts the
# process when a called_from_lib library is unloaded, so these match by module
# in the stack instead.
race:libpipewire-module-client-node.so
race:libpipewire-module-protocol-native.so
race:libspa-support.so
# libproxy, which rtspsrc reaches through GIO's proxy resolver module: the
# same GRecMutex unlock as above. Loaded with a GIO module, which GIO can
# unload, so by module too.
mutex:libpxbackend-1.0.so
race:libpxbackend-1.0.so
# libfaketime (the scheduler scenarios' fake clock) takes its own locks.
deadlock:libfaketimeMT.so.1
deadlock:gst_pad_pause_task
deadlock:gst_pad_stop_task
